<view class="page workspace-page">
  <view class="workspace-nav" style="height: {{navHeight}}px; padding-top: {{menuTop}}px;">
    <view class="workspace-nav-inner" style="height: {{menuHeight}}px;">
      <view class="workspace-avatar nav-avatar" style="width: {{avatarSize}}px; height: {{avatarSize}}px;" bindtap="openSettings"></view>
      <view class="workspace-nav-title">全部</view>
    </view>
  </view>

  <view class="search-compact workspace-search">
    <view class="search-icon"></view>
    <view>搜索全部文件</view>
  </view>

  <view class="section-row folders-title">
    <view class="section-heading">文件夹</view>
  </view>
  <view wx:if="{{loading}}" class="workspace-empty">正在读取...</view>
  <view class="folder-list">
    <view wx:for="{{folders}}" wx:key="id" class="folder-card" bindtap="openNode" data-id="{{item.id}}">
      <view class="folder-icon {{item.theme}}">
        <view class="folder-line"></view>
      </view>
      <view class="folder-copy">
        <view class="folder-name">{{item.title}}</view>
        <view class="folder-count">{{item.count}} 个项目</view>
      </view>
      <view class="chevron"></view>
    </view>
  </view>

  <view class="section-row files-title">
    <view class="section-heading">全部文件</view>
    <view class="sort-action">按时间 排序 <text>↕</text></view>
  </view>
  <view class="file-list">
    <view wx:for="{{files}}" wx:key="id" class="file-card" bindtap="openNode" data-id="{{item.id}}">
      <view class="file-icon {{item.theme}}">{{item.ext}}</view>
      <view class="file-copy">
        <view class="file-name">{{item.title}}</view>
        <view class="file-meta">{{item.meta}}</view>
      </view>
      <view class="more-dot">•••</view>
    </view>
  </view>
  <view wx:if="{{!loading && folders.length === 0 && files.length === 0}}" class="workspace-empty">暂无可阅读文件</view>
</view>
