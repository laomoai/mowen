<view class="setup-page">
  <view class="setup-logo">
    <image class="mowen-logo-image" mode="aspectFit" src="/assets/mowen-logo.svg" />
  </view>

  <view class="setup-title">连接墨问知识空间</view>

  <view class="setup-card">
    <view class="field api-field">
      <text class="label">API Key</text>
      <input class="input" value="{{apiKey}}" password placeholder="mw_..." bindinput="onApiKeyInput" />
    </view>

    <view class="settings-toggle" bindtap="toggleSettings">
      <text>设置</text>
      <text class="toggle-arrow {{settingsOpen ? 'open' : ''}}">⌃</text>
    </view>

    <view wx:if="{{settingsOpen}}" class="field service-field">
      <text class="label">服务地址 (Service Address)</text>
      <input class="input" value="{{baseUrl}}" placeholder="https://mowen.lemoai.cn" bindinput="onBaseUrlInput" />
    </view>
  </view>

  <button class="primary-button connect-button" loading="{{loading}}" bindtap="connect">
    <text>验证并进入</text>
    <text class="button-arrow">→</text>
  </button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
