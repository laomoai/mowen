.setup-page {
  min-height: 100vh;
  padding: 62rpx 66rpx 80rpx;
  box-sizing: border-box;
  background: #f7f8fd;
  color: #111312;
}

.setup-logo {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mowen-logo-image {
  width: 92rpx;
  height: 92rpx;
}

.setup-title {
  text-align: center;
  font-size: 38rpx;
  line-height: 52rpx;
  font-weight: 900;
  margin-bottom: 58rpx;
}

.setup-card {
  padding: 34rpx 40rpx 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.field {
  margin-top: 34rpx;
}

.api-field,
.service-field {
  margin-top: 0;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #111312;
  font-size: 26rpx;
  font-weight: 800;
}

.input {
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 10rpx;
  background: #f1f2f7;
  color: #111312;
  font-size: 30rpx;
  box-sizing: border-box;
}

.settings-toggle {
  width: 120rpx;
  margin-top: 38rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #087a32;
  font-size: 26rpx;
  font-weight: 800;
}

.toggle-arrow {
  font-size: 22rpx;
  line-height: 1;
  transform: rotate(180deg);
}

.toggle-arrow.open {
  transform: rotate(0);
}

.connect-button {
  width: 100%;
  height: 96rpx;
  margin-top: 56rpx;
  border-radius: 16rpx;
  background: #117a2d;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  line-height: 96rpx;
}

.button-arrow {
  font-size: 34rpx;
  line-height: 1;
}

.error {
  margin-top: 24rpx;
  color: #ba1a1a;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}
