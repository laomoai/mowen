<view class="page" capture-bind:touchstart="onTouchStart" capture-bind:touchend="onTouchEnd">
  <view class="page-title">{{title}}</view>
  <view wx:if="{{loading}}" class="empty">正在打开记录...</view>
  <view wx:else class="field-stack">
    <view wx:for="{{items}}" wx:key="column_name" class="field-card card">
      <view class="field-label">{{item.title}}</view>
      <view wx:if="{{item.isImage}}" class="image-list">
        <image wx:if="{{item.displayUrl}}" class="field-image" mode="widthFix" src="{{item.displayUrl}}" />
        <view wx:else class="field-value muted">图片不可用</view>
      </view>
      <view wx:else class="field-value">{{item.valueText}}</view>
    </view>
  </view>
</view>
