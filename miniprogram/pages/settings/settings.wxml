<view class="settings-page">
  <view class="profile-block">
    <image wx:if="{{profilePicture}}" class="profile-avatar" mode="aspectFill" src="{{profilePicture}}" />
    <view wx:else class="profile-avatar profile-avatar-fallback">{{profileInitial}}</view>
    <view class="profile-name">{{profileName}}</view>
    <view wx:if="{{profileEmail}}" class="profile-email">
      <view class="mail-icon"></view>
      <text>邮箱: {{profileEmail}}</text>
    </view>
  </view>

  <view class="settings-divider"></view>

  <view class="workspace-section">
    <view class="workspace-label">当前工作空间</view>
    <view class="workspace-card">
      <view class="workspace-icon">
        <view class="nodes-icon">
          <view></view><view></view><view></view>
        </view>
      </view>
      <view class="workspace-copy">
        <view class="workspace-title">{{workspaceTitle}}</view>
        <view class="workspace-subtitle">{{workspaceSubtitle}}</view>
      </view>
      <view class="switch-icon">↔</view>
    </view>
  </view>

  <button class="logout-button" bindtap="clearAll">
    <text class="logout-icon">↪</text>
    <text>注销 API Key</text>
  </button>
</view>
