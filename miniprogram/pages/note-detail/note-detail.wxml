<view class="md-detail-page">
  <view class="md-hero">
    <view class="md-doc-icon">
      <view class="md-line-icon"></view>
      <view class="md-badge">✓</view>
    </view>
    <view class="md-title">{{title}}</view>
    <view class="md-subtitle">{{note.description || updatedText || 'Markdown 内容'}}</view>
  </view>

  <view class="md-card">
    <view class="md-card-head">
      <view class="md-head-left">
        <view class="md-small-icon"></view>
        <text>Markdown 内容</text>
      </view>
      <view class="md-more">•••</view>
    </view>

    <view wx:if="{{loading}}" class="md-empty">正在读取...</view>
    <rich-text wx:elif="{{nodes.length > 0}}" class="md-content" nodes="{{nodes}}"></rich-text>
    <view wx:else class="md-empty">暂无内容</view>
  </view>
</view>
