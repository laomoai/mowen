page {
  min-height: 100%;
  background: #fbfaf8;
  color: #111312;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 30rpx 150rpx;
  background: #fbfaf8;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.brand-sheet {
  width: 26rpx;
  height: 34rpx;
  border: 4rpx solid #0a8a4b;
  border-radius: 3rpx;
  position: relative;
  box-sizing: border-box;
}

.brand-sheet::after {
  content: "";
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 4rpx solid #0a8a4b;
  border-bottom: 4rpx solid #0a8a4b;
  background: #ffffff;
}

.header-title {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
  color: #111312;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #c8b29a 0%, #f1d9bf 42%, #273443 43%, #172330 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.5);
  flex: none;
}

.search-large,
.search-compact {
  background: #ffffff;
  color: #7e887f;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 5rpx 18rpx rgba(28, 31, 29, .06);
}

.search-large {
  height: 82rpx;
  border-radius: 10rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dedfdb;
  font-size: 28rpx;
}

.search-compact {
  height: 80rpx;
  border-radius: 22rpx;
  padding: 0 30rpx;
  font-size: 29rpx;
  box-shadow: 0 12rpx 34rpx rgba(24, 29, 25, .045);
}

.search-icon {
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #7e887f;
  border-radius: 50%;
  margin-right: 22rpx;
  position: relative;
  flex: none;
}

.search-icon::after {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 5rpx;
  right: -12rpx;
  bottom: -7rpx;
  border-radius: 9rpx;
  background: #7e887f;
  transform: rotate(45deg);
}

.section-row {
  margin-top: 44rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
}

.section-heading {
  flex: 1;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: #2c4130;
}

.section-action {
  font-size: 31rpx;
  color: #007a3d;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border: 1rpx solid #eeeeec;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.muted {
  color: #757b76;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #858b86;
  font-size: 28rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.ghost-button {
  height: 84rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #25342a;
  border: 1rpx solid #dedfdd;
  line-height: 84rpx;
}

.danger-button {
  color: #ba1a1a;
  background: #fff8f7;
  border-color: #ffd8d4;
}

.cell-list {
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 112rpx;
  padding: 20rpx 26rpx;
  border-bottom: 1rpx solid #efefee;
  box-sizing: border-box;
}

.cell:last-child {
  border-bottom: 0;
}

.cell-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef6f0;
  color: #007a3d;
  font-size: 34rpx;
  flex: none;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  font-weight: 600;
  color: #151716;
}

.cell-meta {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: #7a817b;
}

.chevron {
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid #25372a;
  border-right: 5rpx solid #25372a;
  transform: rotate(45deg);
  flex: none;
}
