[Unit]
Description=MoWen (Node + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=mowen
EnvironmentFile=/etc/mowen.env
WorkingDirectory=/opt/mowen/current
ExecStart=/opt/mowen/current/node_modules/.bin/tsx src/server.ts
Restart=on-failure
RestartSec=3
MemoryMax=350M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
