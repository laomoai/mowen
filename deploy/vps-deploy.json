{
  "schemaVersion": 1,
  "project": {
    "name": "mowen",
    "runtime": "node",
    "buildCommand": "npm ci && npm run build:web",
    "testCommand": null,
    "artifactPath": "."
  },
  "server": {
    "targetDirectory": "/opt/mowen",
    "serviceName": "mowen.service",
    "listenHost": "127.0.0.1",
    "listenPort": 18085,
    "environmentFile": "/etc/mowen.env",
    "healthPath": "/api/health"
  },
  "public": {
    "url": "https://mowen.lemoai.cn",
    "nginxConfig": "/etc/nginx/sites-available/mowen.lemoai.cn",
    "websocket": false
  },
  "data": {
    "writableDirectories": ["/var/lib/mowen"],
    "databaseType": "sqlite",
    "backupCommand": "sqlite3 /var/lib/mowen/mowen.sqlite \".backup /opt/backups/mowen/mowen.sqlite\"",
    "integrityCheckCommand": "sqlite3 /var/lib/mowen/mowen.sqlite 'PRAGMA quick_check;'"
  },
  "verification": {
    "localHealthUrl": "http://127.0.0.1:18085/api/health",
    "publicHealthUrl": "https://mowen.lemoai.cn/api/health",
    "browserRequired": true
  }
}
