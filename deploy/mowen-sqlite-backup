#!/bin/sh
set -eu

umask 077

database=/var/lib/mowen/mowen.sqlite
backup_dir=/opt/backups/mowen-scheduled
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
final_path="$backup_dir/mowen-$timestamp.sqlite"

if [ ! -s "$database" ]; then
  echo "source database is missing or empty: $database" >&2
  exit 1
fi

install -d -m 0700 "$backup_dir"
temp_path=$(mktemp "$backup_dir/.mowen-$timestamp.XXXXXX.sqlite")
cleanup() { rm -f "$temp_path"; }
trap cleanup EXIT HUP INT TERM

sqlite3 "$database" ".timeout 10000" ".backup '$temp_path'"

if [ ! -s "$temp_path" ]; then
  echo "sqlite backup produced an empty file" >&2
  exit 1
fi

check=$(sqlite3 "$temp_path" 'PRAGMA quick_check;')
if [ "$check" != "ok" ]; then
  echo "backup integrity check failed: $check" >&2
  exit 1
fi

chmod 0600 "$temp_path"
mv "$temp_path" "$final_path"
sha256sum "$final_path" > "$final_path.sha256"
chmod 0600 "$final_path.sha256"
trap - EXIT HUP INT TERM

bytes=$(stat -c '%s' "$final_path")
echo "backup_ok path=$final_path bytes=$bytes quick_check=ok"
