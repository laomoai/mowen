{
  "name": "mowen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "cd web && npm run dev",
    "start": "tsx src/server.ts",
    "build:web": "cd web && npm run build && mkdir -p ../public/agent && rm -rf ../public/agent/mowen ../public/agent/d1table ../public/agent/mowen.zip && cp -R ../agent/mowen ../public/agent/mowen && (cd ../agent && zip -qr ../public/agent/mowen.zip mowen)",
    "db:migrate": "tsx scripts/migrate.ts",
    "smoke:viewer": "tsx scripts/smoke-viewer.ts"
  },
  "dependencies": {
    "@dicebear/adventurer": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@dicebear/lorelei": "^9.4.2",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^0.18.3",
    "@scalar/hono-api-reference": "^0.5.161",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.6.19",
    "tsx": "^4.20.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "typescript": "^5.7.3"
  }
}
